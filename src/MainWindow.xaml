<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root" Title="Codex 额度监控" Width="292.5" Height="411" WindowStyle="None" ResizeMode="NoResize" Background="{DynamicResource Surface}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
 <Window.Resources>
  <SolidColorBrush x:Key="Surface" Color="#FAFBFB"/><SolidColorBrush x:Key="Ink" Color="#171B20"/>
  <SolidColorBrush x:Key="Muted" Color="#69737D"/><SolidColorBrush x:Key="Line" Color="#DFE3E5"/>
  <SolidColorBrush x:Key="Track" Color="#E2E5E8"/><SolidColorBrush x:Key="Accent" Color="#536967"/>
  <SolidColorBrush x:Key="AccentInk" Color="#FFFFFF"/><SolidColorBrush x:Key="Warning" Color="#965C12"/>
  <SolidColorBrush x:Key="WarningBg" Color="#FFF0D7"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="8,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource Track}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border x:Name="SurfaceBorder" Width="390" Height="548" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="18,14" RenderOptions.ClearTypeHint="Enabled">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid x:Name="Header">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="PlanTitle" Text="订阅套餐暂不可用" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Button x:Name="PinButton" Grid.Column="1" ToolTip="置顶" AutomationProperties.Name="置顶"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE718;" FontSize="17" Foreground="{DynamicResource Muted}"/></Button>
    <Button x:Name="SettingsButton" Grid.Column="2" ToolTip="设置" AutomationProperties.Name="设置"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="17" Foreground="{DynamicResource Muted}"/></Button>
    <Button x:Name="HideButton" Grid.Column="3" ToolTip="收进托盘" AutomationProperties.Name="收进托盘"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="17" Foreground="{DynamicResource Muted}"/></Button>
   </Grid>
   <Grid Grid.Row="1">
    <StackPanel x:Name="MiniPanel" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="MiniText" Text="Codex · 正在读取"/><Button x:Name="ExpandButton" Content="展开" Margin="12,0,0,0"/></StackPanel>
    <Grid x:Name="DetailPanel">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="71"/></Grid.RowDefinitions>
     <ScrollViewer x:Name="SummaryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <TextBlock Text="Codex 使用额度" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
       <StackPanel x:Name="QuotaRows"/>
       <TextBlock x:Name="StatusText" Text="正在连接本机 Codex…" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
       <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,7"/>
       <TextBlock Text="账户详情" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
       <Grid Margin="0,2,0,2"><TextBlock Text="昨日消耗 token"/><TextBlock x:Name="YesterdayTokenText" Text="暂不可用" FontSize="13" HorizontalAlignment="Right"/></Grid>
       <Grid Margin="0,2,0,2"><TextBlock Text="历史累计 token"/><TextBlock x:Name="TotalTokenText" Text="暂不可用" FontSize="13" HorizontalAlignment="Right"/></Grid>
       <TextBlock x:Name="TokenNoteText" Text="官方 token 统计暂不可用。" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
       <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,4"/>
       <Grid Margin="0,4,0,4"><TextBlock Text="Credits 余额"/><TextBlock x:Name="CreditsText" Text="暂不可用" HorizontalAlignment="Right"/></Grid>
       <Border Height="1" Background="{DynamicResource Line}"/>
       <Grid Margin="0,6,0,6"><TextBlock Text="可用重置"/><TextBlock x:Name="ResetText" Text="暂不可用" HorizontalAlignment="Right"/></Grid>
       <Border Height="1" Background="{DynamicResource Line}"/>
       <Grid Margin="0,6,0,6"><TextBlock Text="最近重置到期"/><TextBlock x:Name="ExpiryText" Text="暂不可用" HorizontalAlignment="Right"/></Grid>
       <Border Height="1" Background="{DynamicResource Line}"/>
       <Button x:Name="ResetDetailsButton" HorizontalAlignment="Stretch" Padding="0,3" Margin="0,4,0,0"><Grid Width="350"><TextBlock Text="展开重置详情"/><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/></Grid></Button>
       <StackPanel x:Name="ResetDetails" Visibility="Collapsed" Margin="0,0,0,10"/>
      </StackPanel>
     </ScrollViewer>
     <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock x:Name="UpdatedText" Text="尚未成功读取" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
      <Button x:Name="CollapseButton" Content="收起" FontSize="12" HorizontalAlignment="Right"/>
      <Button x:Name="RefreshButton" Grid.Row="1" Background="{DynamicResource Accent}" Foreground="{DynamicResource AccentInk}" Margin="0,4,0,0"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Foreground="{DynamicResource AccentInk}" Margin="0,0,9,0"/><TextBlock x:Name="RefreshLabel" Text="刷新额度" Foreground="{DynamicResource AccentInk}"/></StackPanel></Button>
     </Grid>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>



